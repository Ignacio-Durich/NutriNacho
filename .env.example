# Copy to .env and fill in with YOUR OWN keys. Never commit .env.
TELEGRAM_TOKEN=your-telegram-bot-token-from-botfather
GEMINI_API_KEY=your-google-ai-studio-api-key
SUPABASE_URL=https://your-project-ref.supabase.co
# Server-side secret key (bypasses RLS) - only ever used by the bot, never in the dashboard
SUPABASE_KEY=your-supabase-secret-key
# Optional: URL of your deployed dashboard (enables the /dashboard command)
DASHBOARD_URL=https://your-dashboard.example.com
